<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.mknaub</groupId>
    <artifactId>AppFXDemo</artifactId>
    <version>0.1-hotfixes</version>
    <packaging>jar</packaging>
    <name>AppFXDemo</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>27</maven.compiler.release>
        <mainClass>de.mknaub.appfxdemo.MainApp</mainClass>

        <version-app-fx>0.3</version-app-fx>
        <version-lombok>1.18.48</version-lombok>
        <version-logback>1.6.3</version-logback>
    </properties>

    <organization>
        <name>MKnaub</name>
    </organization>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <!-- Since JDK 23 javac no longer runs annotation processors found on the class path implicitly -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${version-lombok}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- Runs the application with JavaFX on the module path: mvn javafx:run -->
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
                <executions>
                    <execution>
                        <!-- Used by the NetBeans debug action: mvn javafx:run@ide-debug -->
                        <id>ide-debug</id>
                        <configuration>
                            <options combine.children="append">
                                <option>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</option>
                                <option>-Dglass.disableGrab=true</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>

        <!-- utils -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.20</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${version-logback}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${version-logback}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${version-lombok}</version>
            <scope>provided</scope>
        </dependency>
        <!-- also provides OpenJFX and the javax.annotation API (@PostConstruct) as transitive dependencies -->
        <dependency>
            <groupId>de.mknaub</groupId>
            <artifactId>app-fx</artifactId>
            <version>${version-app-fx}</version>
        </dependency>
    </dependencies>
</project>
